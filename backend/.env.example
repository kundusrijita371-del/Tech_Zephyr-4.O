# Backend environment variables
# Copy this file to .env in the backend/ directory.

# Absolute or repo-root-relative path to the CIT dataset.
# Default: data/cit_public.json (relative to repo root)
# DATASET_PATH=data/cit_public.json

# Comma-separated list of allowed CORS origins.
# Default: http://localhost:3000
# CORS_ORIGINS=http://localhost:3000

# Google Gemini API key for natural language interpretation (English & Hinglish)
# If omitted or invalid, the backend automatically uses the deterministic fallback parser.
# GEMINI_API_KEY=your_gemini_api_key_here

# Timeout in seconds for external AI service calls
# AI_TIMEOUT_SECONDS=5.0

